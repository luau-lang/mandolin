{
  "name": "mandolin",
  "displayName": "Mandolin",
  "description": "Mandolin is an extension designed to consume lint violations reported by Lute!",
  "publisher": "Roblox",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:luau",
    "workspaceContains:**/*.luau",
    "workspaceContains:**/*.lua"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "luau",
        "extensions": [
          ".luau",
          ".lua"
        ]
      }
    ],
    "configuration": {
      "title": "Mandolin",
      "properties": {
        "mandolin.luteExecPath": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "The path to the Lute executable to use for lints"
        },
        "mandolin.lintRules": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "Optional path to custom lint rules"
        },
        "mandolin.foremanTomlPath": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "Optional path to a foreman.toml file describing which version of lute to use"
        },
        "mandolin.lintConfigPath": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "Optional path to a .config.luau file containing lute lint configuration."
        }
      }
    }, 
    "breakpoints": [{ "language": "luau" }],
    "debuggers": [
      {
        "type": "lute",
        "label": "Lute Debugger",
        "languages": ["luau"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the Luau file to debug.",
                "default": "${file}"
              },
              "trace": {
                "type": "boolean",
                "description": "Enable tracing of the Debug Adapter Protocol messages.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lute",
            "request": "launch",
            "name": "Debug Luau File",
            "program": "${file}",
            "trace": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Lute Debug: Launch",
            "description": "A new configuration for debugging a Luau file",
            "body": {
              "type": "lute",
              "request": "launch",
              "name": "Debug Luau File",
              "program": "^\"\\${file}\"",
              "trace": false
            }
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luau-lang/mandolin.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.105.1",
    "@types/which": "^3.0.4",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.2",
    "sinon": "^21.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "which": "^5.0.0"
  }
}
